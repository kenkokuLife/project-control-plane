---
import type { DashboardProject } from '../lib/dashboard.ts';
import { STATUS_LABELS } from '../lib/dashboard.ts';

interface Props {
  project: DashboardProject;
}

const { project } = Astro.props;
---
<article class="project" id={`project-${project.id}`}>
  <header>
    <h3>{project.name}</h3>
    <p class="status-line">
      <span class={`badge badge-${project.status}`}>{STATUS_LABELS[project.status]}</span>
      <span class="stage">{project.stage}</span>
    </p>
  </header>

  <p class="summary">{project.summary}</p>

  <div class="progress">
    <h4>Current</h4>
    {project.current.length > 0
      ? <ul>{project.current.map(item => <li>{item}</li>)}</ul>
      : <p class="none">—</p>}
  </div>

  <div class="progress next">
    <h4>Next</h4>
    {project.next.length > 0
      ? <ul>{project.next.map(item => <li>{item}</li>)}</ul>
      : <p class="none">—</p>}
  </div>

  <footer>
    <span>Updated <time datetime={project.updatedAt}>{project.updatedAt}</time></span>
    <span>Sync {project.syncState}</span>
    <span class="links">
      <a href={project.repoUrl} rel="noopener noreferrer">{project.repo}</a>
      {project.publicUrl && (
        <a href={project.publicUrl} rel="noopener noreferrer" target="_blank">Open ↗</a>
      )}
    </span>
  </footer>
</article>

<style>
  .project {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    min-width: 0;
    padding: 1rem 1.1rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 10px;
  }
  h3 { margin: 0; font-size: 1.1rem; }
  .status-line {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin: 0.3rem 0 0;
  }
  .stage { color: var(--muted); font-size: 0.88rem; }
  .summary { margin: 0; color: var(--muted); }
  h4 {
    margin: 0 0 0.25rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--muted);
  }
  ul { margin: 0; padding-left: 1.1rem; }
  li + li { margin-top: 0.25rem; }
  .none { margin: 0; color: var(--muted); }
  .next {
    padding-left: 0.75rem;
    border-left: 3px solid var(--accent);
  }
  .next h4 { color: var(--accent); }
  footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 1rem;
    margin-top: auto;
    padding-top: 0.5rem;
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: 0.85rem;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1rem;
    min-width: 0;
  }
  .links a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    min-width: 0;
  }
</style>
