{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Project Status v1",
  "description": "正式接入契约；空白模板不满足此 Schema。updatedAt 使用 UTC 日期 YYYY-MM-DD。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "summary",
    "status",
    "stage",
    "current",
    "next",
    "publicUrl",
    "updatedAt"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "stage": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "status": {
      "type": "string",
      "enum": [
        "idea",
        "active",
        "paused",
        "completed",
        "archived"
      ]
    },
    "current": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "next": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "publicUrl": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "format": "uri"
    },
    "updatedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "format": "date"
    }
  }
}
